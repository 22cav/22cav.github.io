---
// A figure with a caption, for project pages and posts. In an .mdx file:
//   import plot from './plot.png';
//   <Figure src={plot} alt="…" caption="…" />
// Figures stay inside the text column; click one to open it at full size.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <a href={src.src} class="figure__link">
    <Image src={src} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 46rem) 100vw, 40rem" />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }

  .figure__link {
    display: block;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 4px;
    /* Diagrams are drawn on white; keep them on white in dark mode too. */
    background: #fff;
  }
</style>
